
---
import "../styles/global.css";
import { Type, WandSparkles, RotateCcw, Download } from "@lucide/astro";

const github = "https://github.com/benzwd/rotk-fonts-changer";
const buyMeACoffee = "https://buymeacoffee.com/zwdev";
const discord = "https://discord.gg/GAQcFTzs";

const features = [
  {
    number: "01",
    icon: Type,
    title: "LIVE FONT PREVIEW",
    description:
      "See how your custom font looks before applying it to ROTK.",
  },
  {
    number: "02",
    icon: WandSparkles,
    title: "ONE-CLICK APPLY",
    description:
      "Replace game font files with your selected TrueType font.",
  },
  {
    number: "03",
    icon: RotateCcw,
    title: "RESTORE DEFAULTS",
    description:
      "Restore the original game fonts whenever you want.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>ROTK Font Changer</title>

    <meta
      name="description"
      content="ROTK Font Changer is a free Windows utility for customizing ROTK Z1 game fonts. Preview custom TTF fonts, apply changes and restore defaults easily."
    />

    <meta name="robots" content="index, follow" />

    <link
      rel="canonical"
      href="https://rotkfontchanger.com/"
    />

    <link
      rel="sitemap"
      href="/sitemap-index.xml"
    />

    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="ROTK Font Changer"
    />
    <meta
      property="og:description"
      content="Your font. Your game. Customize ROTK fonts with a free Windows utility."
    />
    <meta
      property="og:url"
      content="https://rotkfontchanger.com/"
    />

    <meta name="theme-color" content="#0d0d0d" />
  </head>

  <body class="min-h-screen">
    <header class="site-header">
      <nav class="site-container nav-content">
        <a href="/" class="brand" aria-label="ROTK Font Changer home">
          <span class="brand-mark">ROTK</span>
          <span class="brand-divider"></span>

          <span class="brand-details">
            <span class="brand-name">FONT CHANGER</span>
            <span class="brand-subtitle">UNOFFICIAL UTILITY</span>
          </span>
        </a>

        <div class="nav-links">
          <a href="#features">FEATURES</a>

          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
          >
            GITHUB
          </a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-glow" aria-hidden="true"></div>

        <div class="site-container hero-content">
          <div class="eyebrow">
            <span>CUSTOMIZATION</span>
            <span class="eyebrow-line">━━━</span>
            <span>FONTS</span>
          </div>

          <h1 class="hero-title">
            YOUR FONT.{" "}
            <span>YOUR GAME.</span>
          </h1>

          <p class="hero-description">
            Customize the ROTK experience with your own font.
            Preview, apply and restore your game fonts
            with a simple Windows application.
          </p>

          <div class="hero-actions">
            <a
              id="download-button"
              class="button button-primary button-disabled"
              aria-disabled="true"
              tabindex="-1"
            >
              <Download size={19} stroke-width={2} />
              <span id="download-label">
                DOWNLOAD COMING SOON
              </span>
            </a>

            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class="button button-secondary"
            >
              VIEW ON GITHUB
            </a>
          </div>

          <div
            id="download-stats"
            class="download-stats"
            aria-live="polite"
          >
            <Download size={14} stroke-width={1.8} />
            <span id="download-count">0</span>
            <span>downloads</span>
          </div>

          <div class="hero-meta">
            <span class="status-dot"></span>
            WINDOWS
            <span class="meta-separator">/</span>
            FREE
            <span class="meta-separator">/</span>
            <span>VERSION <span id="app-version">0.2.0</span></span>
          </div>

          <div class="comparison-section">
            <div class="comparison-heading">
              <div>
                <span class="section-kicker">
                  SEE THE DIFFERENCE
                </span>

                <h2>
                  SAME GAME.{" "}
                  <span>NEW LOOK.</span>
                </h2>
              </div>

              <p>
                Drag the slider to compare the original
                game font with a custom font.
              </p>
            </div>

            <div
              class="comparison"
              id="font-comparison"
              style="--split: 50%;"
            >
              <img
                class="comparison-image comparison-after"
                src="/images/rotk-after.webp"
                alt="ROTK game interface with a custom font"
                draggable="false"
                onerror="this.style.visibility='hidden'"
              />

              <div class="comparison-before-container">
                <img
                  class="comparison-image comparison-before"
                  src="/images/rotk-before.webp"
                  alt="ROTK game interface with its original font"
                  draggable="false"
                  onerror="this.style.visibility='hidden'"
                />
              </div>

              <div class="comparison-placeholder" aria-hidden="true">
                <div class="placeholder-top">
                  <span>ROTK / FONT COMPARISON</span>
                  <span>PREVIEW</span>
                </div>

                <div class="placeholder-center">
                  <span class="placeholder-word">GAGNEZ</span>
                  <span class="placeholder-description">
                    ADD YOUR BEFORE & AFTER SCREENSHOTS
                  </span>
                </div>
              </div>

              <span class="comparison-label label-before">
                BEFORE
              </span>

              <span class="comparison-label label-after">
                AFTER
              </span>

              <div class="comparison-divider" aria-hidden="true">
                <div class="comparison-handle">
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M9 7L4 12L9 17M15 7L20 12L15 17"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </div>
              </div>

              <input
                class="comparison-range"
                type="range"
                min="0"
                max="100"
                value="50"
                step="1"
                aria-label="Compare original and custom ROTK fonts"
              />
            </div>

            <div class="comparison-footer">
              <span>
                <span class="comparison-dot"></span>
                ORIGINAL FONT
              </span>

              <span>DRAG TO COMPARE ↔</span>

              <span>
                <span class="comparison-dot red"></span>
                CUSTOM FONT
              </span>
            </div>
          </div>
        </div>
      </section>

      <section id="features" class="features-section">
        <div class="site-container">
          <div class="section-heading">
            <span class="section-kicker">
              BUILT FOR CUSTOMIZATION
            </span>

            <h2>
              EVERYTHING YOU{" "}
              <span>NEED.</span>
            </h2>

            <p>
              Simple tools. Full control over your game fonts.
            </p>
          </div>

          <div class="features-showcase">
            <div class="features-preview">
              <div class="features-preview-header">
                <span>
                  <span class="preview-status-dot"></span>
                  APPLICATION PREVIEW
                </span>

                <span>WINDOWS / v<span id="app-version">0.2.0</span></span>
              </div>

              <div class="features-preview-image">
                <img
                  src="/images/image.png"
                  alt="ROTK Font Changer Windows application screenshot"
                  loading="lazy"
                />
              </div>

              <div class="features-preview-footer">
                <span>ROTK FONT CHANGER</span>
                <span>DESKTOP UTILITY</span>
              </div>
            </div>

            <div class="features-list">
              {
                features.map((feature) => {
                  const Icon = feature.icon;

                  return (
                    <article class="feature-card">
                      <div class="feature-icon">
                        <Icon size={24} stroke-width={1.8} />
                      </div>

                      <div class="feature-content">
                        <div class="feature-title-row">
                          <h3>{feature.title}</h3>
                          <span class="feature-number">
                            {feature.number}
                          </span>
                        </div>

                        <p>{feature.description}</p>
                      </div>
                    </article>
                  );
                })
              }
            </div>
          </div>

          <div class="features-bottom">
            <span class="status-dot"></span>
            OPEN SOURCE
            <span class="meta-separator">/</span>
            WINDOWS
          </div>
        </div>
      </section>
    </main>

    <a
      href={buyMeACoffee}
      target="_blank"
      rel="noopener noreferrer"
      class="coffee-button"
      aria-label="Support the project on Buy Me a Coffee"
    >
      <span class="coffee-icon">☕</span>
      <span class="coffee-text">BUY ME A COFFEE</span>
    </a>

    <footer class="site-footer">
      <div class="site-container footer-content">
        <div class="footer-left">
          <span>
            © 2026 ROTK FONT CHANGER
          </span>

          <span class="footer-divider">/</span>

          <span>
            MADE WITH ❤ BY{" "} 
            <a
              href="https://github.com/benzwd"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-author"
            >
              FENIIX
            </a>
          </span>
        </div>

        <div class="footer-links">
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
          >
            SOURCE CODE
          </a>

          <a
            href={discord}
            target="_blank"
            rel="noopener noreferrer"
          >
            DISCORD
          </a>
        </div>
      </div>

      <div class="site-container footer-disclaimer">
        UNOFFICIAL COMMUNITY TOOL. NOT AFFILIATED WITH
        OR ENDORSED BY THE CREATORS OF ROTK.
      </div>
    </footer>

    <script>
      const comparison = document.querySelector<HTMLElement>(
        "#font-comparison"
      );

      const range = comparison?.querySelector<HTMLInputElement>(
        ".comparison-range"
      );

      if (comparison && range) {
        const updateComparison = () => {
          comparison.style.setProperty(
            "--split",
            `${range.value}%`
          );
        };

        range.addEventListener("input", updateComparison);
        updateComparison();
      }

      interface GithubAsset {
        name: string;
        download_count: number;
        browser_download_url: string;
      }

      interface GithubRelease {
        tag_name: string;
        draft: boolean;
        prerelease: boolean;
        assets: GithubAsset[];
      }

      const downloadButton =
        document.querySelector<HTMLAnchorElement>(
          "#download-button"
        );

      const downloadLabel =
        document.querySelector<HTMLElement>(
          "#download-label"
        );

      const downloadStats =
        document.querySelector<HTMLElement>(
          "#download-stats"
        );

      const downloadCount =
        document.querySelector<HTMLElement>(
          "#download-count"
        );

      async function loadDownloadStats() {
        try {
          const response = await fetch(
            "https://api.github.com/repos/benzwd/rotk-fonts-changer/releases?per_page=100",
            {
              headers: {
                Accept: "application/vnd.github+json",
              },
            }
          );

          if (!response.ok) {
            throw new Error(
              `GitHub API error: ${response.status}`
            );
          }

          const releases =
            (await response.json()) as GithubRelease[];

          // Count downloads across all published releases.
          const publishedReleases = releases.filter(
            (release) => !release.draft && !release.prerelease
          );

          const latestRelease = publishedReleases.find(
            (release) =>
              release.assets.some(
                (asset) =>
                  asset.name.toLowerCase() ===
                  "rotkfontchanger.exe"
              )
          );

          if (latestRelease) {
            const version = latestRelease.tag_name.replace(/^v/i, "");

            const appVersion = document.querySelector<HTMLElement>(
              "#app-version"
            );

            const previewVersion = document.querySelector<HTMLElement>(
              "#preview-version"
            );

            if (appVersion) {
              appVersion.textContent = version;
            }

            if (previewVersion) {
              previewVersion.textContent = `v${version}`;
            }
          }

          const executableAssets = publishedReleases.flatMap(
            (release) =>
              release.assets.filter(
                (asset) =>
                  asset.name.toLowerCase() ===
                  "rotkfontchanger.exe"
              )
          );

          // No executable release yet.
          if (executableAssets.length === 0) {
            return;
          }

          const totalDownloads = executableAssets.reduce(
            (total, asset) =>
              total + asset.download_count,
            0
          );

          // First executable of the latest published release
          // that actually contains the application.
          const latestExecutable = publishedReleases
            .flatMap((release) =>
              release.assets.filter(
                (asset) =>
                  asset.name.toLowerCase() ===
                  "rotkfontchanger.exe"
              )
            )[0];

          if (
            downloadButton &&
            downloadLabel &&
            latestExecutable
          ) {
            downloadButton.href =
              latestExecutable.browser_download_url;

            downloadButton.classList.remove(
              "button-disabled"
            );

            downloadButton.removeAttribute(
              "aria-disabled"
            );

            downloadButton.removeAttribute(
              "tabindex"
            );

            downloadLabel.textContent =
              "DOWNLOAD FOR WINDOWS";
          }

          if (downloadStats && downloadCount) {
            downloadCount.textContent =
              totalDownloads.toLocaleString("en-US");

            downloadStats.hidden = false;
          }
        } catch (error) {
          console.error(
            "Failed to load GitHub download stats:",
            error
          );
        }
      }

      loadDownloadStats();

    </script>
  </body>
</html>
